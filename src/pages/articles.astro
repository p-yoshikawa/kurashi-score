---
import Layout from '../layouts/Layout.astro';

const articles = [
  {
    title: '30代既婚世帯が格安SIMに乗り換えるといくら節約できる？',
    description: '大手キャリアから格安SIMへ乗り換えた場合の具体的な節約効果と、契約前に知っておくべき注意点を分かりやすく解説します。',
    link: '/sim-savings-guide',
    tag: '通信費の節約'
  },
  {
    title: '大手キャリアと格安SIMの違いをわかりやすく解説',
    description: '「そもそも格安SIMって何？」という疑問にお答えします。通信速度・サポート体制・料金の3軸から中立に比較解説。',
    link: '/sim-vs-major',
    tag: '通信費の基礎知識'
  },
  {
    title: '30代子育て世帯の通信費平均と見直しポイント',
    description: '子育て世帯のリアルな通信費の平均額と、今の生活レベルを落とさずに無理なく固定費を下げるための具体的な見直し手順。',
    link: '/family-communication-cost',
    tag: '家計改善ガイド'
  }
];
---

<Layout title="家計見直し・通信費削減の解説記事一覧 | くらしスコア" description="年収400万以下の30代世帯に向けた、通信費削減や家計見直しに関する役立つ解説記事の一覧です。">
  <div class="max-w-4xl mx-auto py-12 px-4">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">解説記事一覧</h1>
      <p class="text-slate-600 text-lg">無理なく実践できる家計見直しや通信費削減のポイントを解説します。</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {articles.map(article => (
        <a href={article.link} class="group flex flex-col bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all hover:-translate-y-1">
          <div class="p-6 flex-grow flex flex-col">
            <div class="mb-4">
              <span class="inline-block px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-full">{article.tag}</span>
            </div>
            <h2 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-blue-600 transition-colors leading-snug">{article.title}</h2>
            <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-grow">{article.description}</p>
            <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between text-blue-600 font-medium text-sm">
              記事を読む
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl text-center">
      <h2 class="text-2xl font-bold text-slate-800 mb-4">まずは現状を把握しましょう</h2>
      <p class="text-slate-600 mb-6 max-w-xl mx-auto">家計の見直しは、現在の状況を正しく知ることから始まります。12の質問であなたの家計スコアを無料診断します。</p>
      <a href="/score" class="inline-flex items-center justify-center bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-xl shadow transition-colors">
        無料で家計診断する
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </a>
    </div>

  </div>
</Layout>
