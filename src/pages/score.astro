---
import Layout from '../layouts/Layout.astro';
import AffiliateScoreCards from '../components/AffiliateScoreCards.astro';
---

<Layout title="家計スコア診断フォーム | くらしスコア" description="12の質問に答えて、あなたの家計スコアと改善ポイントを診断しましょう。">
  <div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-2">家計スコア診断</h1>
      <p class="text-slate-600 mb-2">現在の家計状況を入力してください。リアルな数値を入力するほど正確なアドバイスが受けられます。</p>
      <p class="text-sm font-medium text-blue-700 bg-blue-50 py-2 px-4 rounded-lg inline-block">※通信費や光熱費などは<strong class="font-bold">「世帯合算」</strong>で入力してください。</p>
    </div>

    <!-- Alert for Negative Balance (Hidden by default) -->
    <div id="deficit-alert" class="hidden bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-8 rounded shadow-sm" role="alert">
      <div class="flex items-center">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <p class="font-bold">警告：毎月の収支が赤字になっています</p>
      </div>
      <p class="text-sm mt-2 ml-8">早急な家計の見直しが必要です。提案内容を参考に固定費などの削減を検討してください。</p>
    </div>

    <!-- Form Section -->
    <div id="form-section" class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-slate-100">
      <form id="score-form" class="space-y-6">
        
        <!-- 基本情報 -->
        <div>
          <h2 class="text-xl font-bold text-slate-800 mb-4 border-b pb-2">基本情報</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="age" class="block text-sm font-medium text-slate-700 mb-1">年齢</label>
              <div class="relative">
                <input type="number" id="age" required min="18" max="100" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors" placeholder="30">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">歳</span>
              </div>
            </div>
            
            <div>
              <label for="children" class="block text-sm font-medium text-slate-700 mb-1">子ども人数</label>
              <select id="children" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors">
                <option value="0">0人</option>
                <option value="1">1人以上</option>
              </select>
            </div>
            
            <div class="md:col-span-2">
              <label for="income" class="block text-sm font-medium text-slate-700 mb-1">世帯の手取り月収（合計）</label>
              <div class="relative">
                <input type="number" id="income" required min="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors" placeholder="350000">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 毎月の支出 -->
        <div>
          <h2 class="text-xl font-bold text-slate-800 mb-4 border-b pb-2 mt-8">毎月の支出</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="rent" class="block text-sm font-medium text-slate-700 mb-1">家賃 / 住宅ローン</label>
              <div class="relative">
                <input type="number" id="rent" required min="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>

            <div>
              <label for="food" class="block text-sm font-medium text-slate-700 mb-1">食費（外食含む）</label>
              <div class="relative">
                <input type="number" id="food" required min="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>

            <div>
              <label for="utility" class="block text-sm font-medium text-slate-700 mb-1">水道光熱費</label>
              <div class="relative">
                <input type="number" id="utility" required min="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>

            <div>
              <label for="communication" class="block text-sm font-medium text-slate-700 mb-1">通信費（スマホ・ネット）</label>
              <div class="relative">
                <input type="number" id="communication" required min="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>

            <div>
              <label for="insurance" class="block text-sm font-medium text-slate-700 mb-1">保険料（生命・医療など）</label>
              <div class="relative">
                <input type="number" id="insurance" required min="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>

            <div>
              <label for="subscription" class="block text-sm font-medium text-slate-700 mb-1">サブスク・定額サービス</label>
              <div class="relative">
                <input type="number" id="subscription" required min="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>
            
            <!-- 教育費 (children=1の時だけJSで表示制御) -->
            <div id="education-group" class="hidden md:col-span-2">
              <label for="education" class="block text-sm font-medium text-slate-700 mb-1">教育費（習い事・学費など）</label>
              <div class="relative">
                <input type="number" id="education" min="0" value="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 資産・投資 -->
        <div>
          <h2 class="text-xl font-bold text-slate-800 mb-4 border-b pb-2 mt-8">資産・投資</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="investment" class="block text-sm font-medium text-slate-700 mb-1">毎月の投資額（NISA等）</label>
              <div class="relative">
                <input type="number" id="investment" required min="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>

            <div>
              <label for="savings" class="block text-sm font-medium text-slate-700 mb-1">現在の貯蓄額（全口座の合計）</label>
              <div class="relative">
                <input type="number" id="savings" required min="0" class="w-full pl-3 pr-10 py-2 border border-slate-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-slate-50 transition-colors" placeholder="3000000">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">円</span>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-6">
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-6 rounded-xl transition-all shadow-md hover:shadow-lg transform hover:-translate-y-1 text-lg flex justify-center items-center">
            診断する
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Results Section (Hidden by default) -->
    <div id="result-section" class="hidden opacity-0 transition-opacity duration-500">
      
      <!-- Score Hero -->
      <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white p-8 rounded-3xl shadow-2xl mb-8 relative overflow-hidden">
        <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-blue-500 opacity-10 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-64 h-64 rounded-full bg-indigo-500 opacity-10 blur-3xl"></div>
        
        <div class="relative z-10 flex flex-col items-center">
          <h2 class="text-xl font-medium text-blue-200 mb-2">総合診断スコア</h2>
          <div class="flex items-end justify-center mb-4">
            <span id="score-value" class="text-7xl font-bold tracking-tight">--</span>
            <span class="text-3xl font-medium text-slate-400 mb-2 ml-1">/100</span>
          </div>
          
          <div class="bg-white/10 backdrop-blur-md px-6 py-2 rounded-full border border-white/20 shadow-inner flex items-center gap-3">
            <span class="text-sm text-blue-100">家計ランク</span>
            <span id="rank-value" class="text-3xl font-black text-yellow-400 drop-shadow-md">S</span>
          </div>
        </div>
      </div>

      <!-- Chart and Potential -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white p-6 rounded-2xl shadow-md border border-slate-100 flex flex-col">
          <h3 class="font-bold text-slate-800 mb-6 flex items-center">
            <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            スコア内訳
          </h3>
          <div class="flex-grow w-full relative min-h-[250px]">
            <canvas id="score-chart"></canvas>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-md border border-slate-100 flex flex-col justify-center items-center text-center">
          <h3 class="font-bold text-slate-800 mb-2">年間の改善余地</h3>
          <p class="text-sm text-slate-500 mb-6">提案を実行した場合の目安額</p>
          <div class="text-4xl font-bold text-green-600 mb-2 break-all">
            <span id="potential-value">0</span><span class="text-xl ml-1">円</span>
          </div>
          <p class="text-sm text-slate-500">※あくまで目安であり、実際の効果を保証するものではありません。</p>
        </div>
      </div>

      <!-- Recommendations -->
      <div class="mb-12">
        <h3 class="text-2xl font-bold text-slate-800 mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          優先して取り組むべき改善提案
        </h3>
        <div id="recommendations-container" class="space-y-4">
          <!-- JS will populate this -->
        </div>
      </div>

      <!-- 改善サポート (Affiliate CTAs) -->
      <AffiliateScoreCards />

      <!-- Related Articles -->
      <div id="related-articles-section" class="mb-12 hidden">
        <h3 class="text-xl font-bold text-slate-800 mb-4 flex items-center border-b pb-2">
          <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5L18.5 8H20"></path></svg>
          関連する解説記事
        </h3>
        <div id="related-articles-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- JS will populate this -->
        </div>
        <div class="mt-6 text-right">
          <a href="/articles" class="text-sm font-medium text-blue-600 hover:text-blue-800 inline-flex items-center">
            すべての記事を見る
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>

      <div class="mt-12 text-center">
        <button id="reset-btn" class="text-slate-500 hover:text-blue-600 font-medium transition-colors underline decoration-slate-300 underline-offset-4">
          条件を変えて再診断する
        </button>
      </div>
      
    </div>
  </div>
</Layout>

<script>
  import { calcScore } from '../lib/calcScore';
  import Chart from 'chart.js/auto';

  let myChart: Chart | null = null;
  const STORAGE_KEY = 'kurashiScoreInput';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('score-form') as HTMLFormElement;
    const childrenSelect = document.getElementById('children') as HTMLSelectElement;
    const educationGroup = document.getElementById('education-group') as HTMLDivElement;
    const educationInput = document.getElementById('education') as HTMLInputElement;
    
    const formSection = document.getElementById('form-section') as HTMLDivElement;
    const resultSection = document.getElementById('result-section') as HTMLDivElement;
    const deficitAlert = document.getElementById('deficit-alert') as HTMLDivElement;
    const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;

    const inputIds = [
      'age', 'income', 'children', 'rent', 'food', 'utility', 
      'communication', 'insurance', 'subscription', 'education', 
      'investment', 'savings'
    ];

    // Load from LocalStorage
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const data = JSON.parse(saved);
        inputIds.forEach(id => {
          if (data[id] !== undefined) {
             const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
             if (el) el.value = data[id];
          }
        });
        
        // Trigger select change to show/hide education
        const event = new Event('change');
        childrenSelect.dispatchEvent(event);
      }
    } catch (e) {
      console.error('Failed to parse localStorage', e);
    }

    // Toggle Education Field based on children selection
    childrenSelect.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      if (val === '1') {
        educationGroup.classList.remove('hidden');
        educationInput.setAttribute('required', 'true');
      } else {
        educationGroup.classList.add('hidden');
        educationInput.removeAttribute('required');
        educationInput.value = '0'; // reset
      }
    });
    
    // Check initial state
    if (childrenSelect.value === '1') {
        educationGroup.classList.remove('hidden');
        educationInput.setAttribute('required', 'true');
    }

    // Reset Flow
    resetBtn.addEventListener('click', () => {
      resultSection.classList.add('opacity-0');
      setTimeout(() => {
        resultSection.classList.add('hidden');
        deficitAlert.classList.add('hidden');
        formSection.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }, 500);
    });

    // Form Submit Flow
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Retrieve and default empty strings to 0
      const getValue = (id: string) => {
        const val = (document.getElementById(id) as HTMLInputElement).value;
        if (val.trim() === '') return 0;
        const num = Number(val);
        return isNaN(num) ? 0 : num;
      };

      // Gather Input
      const input = {
        age: getValue('age'),
        income: getValue('income'),
        children: Number(childrenSelect.value) as 0 | 1,
        rent: getValue('rent'),
        food: getValue('food'),
        utility: getValue('utility'),
        communication: getValue('communication'),
        insurance: getValue('insurance'),
        subscription: getValue('subscription'),
        education: getValue('education'),
        investment: getValue('investment'),
        savings: getValue('savings')
      };

      // Save to storage
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(input));
      } catch (e) {
        console.error('Failed to save to localStorage', e);
      }

      // Calculate logic
      const result = calcScore(input);

      // Deficit Check
      if (result.surplusMonthly < 0) {
        deficitAlert.classList.remove('hidden');
      } else {
        deficitAlert.classList.add('hidden');
      }

      // Update UI
      (document.getElementById('score-value') as HTMLSpanElement).innerText = Math.floor(result.totalScore).toString();
      
      const rankEl = document.getElementById('rank-value') as HTMLSpanElement;
      rankEl.innerText = result.rank;
      // Change color based on rank
      rankEl.className = 'text-3xl font-black drop-shadow-md ' + 
        (result.rank === 'S' || result.rank === 'A' ? 'text-yellow-400' : 
         result.rank === 'B' ? 'text-blue-300' : 'text-slate-400');

      (document.getElementById('potential-value') as HTMLSpanElement).innerText = result.annualImprovementPotential.toLocaleString();

      // Render Recommendations
      const recContainer = document.getElementById('recommendations-container') as HTMLDivElement;
      recContainer.innerHTML = '';
      if (result.recommendations.length > 0) {
        result.recommendations.forEach((rec, index) => {
          const formattedImpact = rec.annualImpact > 0 ? `<div class="bg-green-50 text-green-700 px-3 py-2 rounded mb-3 text-sm font-bold flex items-center"><svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>期待できる効果: 年間約 ${rec.annualImpact.toLocaleString()} 円</div>` : '';
          
          let stepsHtml = '';
          if (rec.nextSteps && rec.nextSteps.length > 0) {
            stepsHtml = '<div class="mb-4"><span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Next Action</span><ul class="mt-1 space-y-1">';
            rec.nextSteps.forEach(step => {
               stepsHtml += `<li class="text-sm text-slate-700 flex items-start"><svg class="w-4 h-4 text-blue-500 mr-1.5 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>${step}</li>`;
            });
            stepsHtml += '</ul></div>';
          }

          let inlineCtaHtml = '';
          if (rec.link === '/sim-compare') {
            inlineCtaHtml = `
              <div class="mt-5 bg-[#F9FAFB] p-4 rounded-xl">
                <div class="font-bold text-sm text-slate-800 mb-3 flex items-center">
                  <span class="mr-1.5">💡</span> すぐに乗り換え候補を確認する
                </div>
                
                <div class="space-y-3">
                  <!-- UQ mobile -->
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100 last:border-0 last:pb-0">
                    <div>
                      <h5 class="font-bold text-slate-800 text-sm mb-1">UQ mobile</h5>
                      <ul class="text-xs text-slate-600 space-y-0.5">
                        <li class="flex items-center"><svg class="w-3 h-3 text-blue-500 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>au回線で安定</li>
                        <li class="flex items-center"><svg class="w-3 h-3 text-blue-500 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>家族割あり</li>
                      </ul>
                    </div>
                    <a href="#" target="_blank" rel="noopener noreferrer" data-cta="sim_uq_inline" data-position="inline" class="score-cta-btn shrink-0 w-full sm:w-auto text-center bg-[#EFF6FF] text-[#2563EB] hover:bg-[#DBEAFE] hover:text-[#1D4ED8] font-bold py-2 px-4 rounded-lg transition-colors text-xs">
                      公式で料金を見る &rarr;
                    </a>
                  </div>

                  <!-- LIBMO -->
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100 last:border-0 last:pb-0">
                    <div>
                      <h5 class="font-bold text-slate-800 text-sm mb-1">LIBMO</h5>
                      <ul class="text-xs text-slate-600 space-y-0.5">
                        <li class="flex items-center"><svg class="w-3 h-3 text-blue-500 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>低価格重視</li>
                        <li class="flex items-center"><svg class="w-3 h-3 text-blue-500 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>シンプル料金</li>
                      </ul>
                    </div>
                    <a href="#" target="_blank" rel="noopener noreferrer" data-cta="sim_libmo_inline" data-position="inline" class="score-cta-btn shrink-0 w-full sm:w-auto text-center bg-[#EFF6FF] text-[#2563EB] hover:bg-[#DBEAFE] hover:text-[#1D4ED8] font-bold py-2 px-4 rounded-lg transition-colors text-xs">
                      詳細を確認する &rarr;
                    </a>
                  </div>
                </div>
              </div>
            `;
          } else if (rec.link === '/insurance-review') {
            inlineCtaHtml = `
              <div class="mt-5 bg-[#F9FAFB] p-4 rounded-xl">
                <div class="font-bold text-sm text-slate-800 mb-3 flex items-center">
                  <span class="mr-1.5">💡</span> 保障内容をプロに相談する選択肢もあります
                </div>
                
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div>
                    <h5 class="font-bold text-slate-800 text-sm mb-1">ファインドイット</h5>
                    <ul class="text-xs text-slate-600 space-y-0.5">
                      <li class="flex items-center"><svg class="w-3 h-3 text-blue-500 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>無料オンライン相談</li>
                      <li class="flex items-center"><svg class="w-3 h-3 text-blue-500 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>複数社から最適提案</li>
                    </ul>
                  </div>
                  <a href="#" target="_blank" rel="noopener noreferrer" data-cta="hoken_findit_inline" data-position="inline" class="score-cta-btn shrink-0 w-full sm:w-auto text-center bg-[#EFF6FF] text-[#2563EB] hover:bg-[#DBEAFE] hover:text-[#1D4ED8] font-bold py-2 px-4 rounded-lg transition-colors text-xs">
                    無料で相談内容を確認 &rarr;
                  </a>
                </div>
              </div>
            `;
          }

          recContainer.innerHTML += `
            <div class="bg-white border ${rec.priority === 999 ? 'border-red-200' : 'border-slate-200'} p-5 md:p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
              <div class="absolute left-0 top-0 bottom-0 w-1.5 ${rec.priority === 999 ? 'bg-red-500' : 'bg-blue-500'} rounded-l-xl"></div>
              <div class="ml-2">
                <div class="flex justify-between items-start mb-2">
                  <h4 class="font-bold text-lg ${rec.priority === 999 ? 'text-red-700' : 'text-slate-800'} transition-colors">${rec.title}</h4>
                  ${rec.priority !== 999 ? `<span class="inline-flex items-center justify-center bg-slate-100 text-slate-500 font-bold text-xs rounded-full w-6 h-6 shrink-0">${index + (result.recommendations.some(r => r.priority === 999) ? 0 : 1)}</span>` : '<span class="inline-flex items-center justify-center bg-red-100 text-red-600 font-bold text-xs px-2 py-0.5 rounded shrink-0">必須</span>'}
                </div>
                <p class="text-slate-600 text-sm mb-3">${rec.description}</p>
                ${formattedImpact}
                ${stepsHtml}
                <a href="${rec.link}" class="inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 bg-slate-50 hover:bg-blue-50 text-sm font-medium ${rec.priority === 999 ? 'text-red-600 hover:text-red-700 border border-red-200' : 'text-blue-600 hover:text-blue-700 border border-blue-100'} rounded-lg transition-colors">
                  ${rec.linkText}
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
                ${inlineCtaHtml}
              </div>
            </div>
          `;
        });
      } else {
        recContainer.innerHTML = `
          <div class="bg-green-50 text-green-800 p-6 rounded-xl border border-green-200 flex items-start">
            <svg class="w-6 h-6 mr-3 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <div>
              <h4 class="font-bold mb-1">素晴らしい家計状況です！</h4>
              <p class="text-sm">現在、特に優先して改善すべき項目は見当たりません。この調子で堅実な運用を続けてください。</p>
            </div>
          </div>
        `;
      }

      // Render Related Articles based on recommendations
      const relatedSection = document.getElementById('related-articles-section') as HTMLDivElement;
      const relatedContainer = document.getElementById('related-articles-container') as HTMLDivElement;
      relatedContainer.innerHTML = '';
      
      const articleDb = [
        { id: 'sim', keywords: ['/sim-compare', '/subs-cleanup'], link: '/sim-savings-guide', title: '30代既婚世帯が格安SIMに乗り換えるといくら節約できる？', desc: '大手キャリアからの乗り換え節約術' },
        { id: 'sim-major', keywords: ['/sim-compare'], link: '/sim-vs-major', title: '大手キャリアと格安SIMの違いをわかりやすく解説', desc: '通信費見直しの基礎知識' },
        { id: 'family-comm', keywords: ['/fixed-cost-guide'], link: '/family-communication-cost', title: '30代子育て世帯の通信費平均と見直しポイント', desc: '子育て世帯のリアルな通信費実態と対策' }
      ];

      const matchedArticles = new Map();
      result.recommendations.forEach(rec => {
        articleDb.forEach(art => {
          if (art.keywords.includes(rec.link) || (rec.title.includes('固定費') && art.id === 'family-comm' && input.children === 1)) {
            matchedArticles.set(art.link, art);
          }
        });
      });

      if (matchedArticles.size > 0) {
        relatedSection.classList.remove('hidden');
        Array.from(matchedArticles.values()).slice(0, 2).forEach(art => {
          relatedContainer.innerHTML += `
            <a href="${art.link}" class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md hover:border-blue-200 group transition-all flex flex-col">
              <h4 class="font-bold text-slate-800 text-sm group-hover:text-blue-600 mb-2 leading-snug">${art.title}</h4>
              <p class="text-xs text-slate-500 mt-auto">${art.desc}</p>
            </a>
          `;
        });
      } else {
        // Fallback: show one generic article if no specific match
        relatedSection.classList.remove('hidden');
        relatedContainer.innerHTML += `
            <a href="/sim-savings-guide" class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md hover:border-blue-200 group transition-all flex flex-col">
              <h4 class="font-bold text-slate-800 text-sm group-hover:text-blue-600 mb-2 leading-snug">30代既婚世帯が格安SIMに乗り換えるといくら節約できる？</h4>
              <p class="text-xs text-slate-500 mt-auto">通信費を見直すための第一歩</p>
            </a>
            <a href="/articles" class="bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm hover:bg-slate-100 group transition-all flex flex-col justify-center items-center h-full min-h-[100px]">
              <span class="text-sm font-bold text-slate-700 group-hover:text-blue-600 flex items-center">
                他の記事も探す
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </span>
            </a>
        `;
      }

      // Render Chart
      const ctx = (document.getElementById('score-chart') as HTMLCanvasElement).getContext('2d');
      if (myChart) {
        myChart.destroy();
      }
      
      const labels = ['貯蓄率', '固定費', '投資比率', '年齢貯蓄', '保険適正'];
      const data = [
        result.details.savingsRateScore,
        result.details.fixedCostScore,
        result.details.investmentScore,
        result.details.ageSavingsScore,
        result.details.insuranceScore
      ];
      
      if (ctx) {
        myChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'スコア',
              data: data,
              backgroundColor: 'rgba(59, 130, 246, 0.8)',
              borderColor: 'rgba(37, 99, 235, 1)',
              borderWidth: 1,
              borderRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                beginAtZero: true,
                max: 30,
              }
            },
            plugins: {
              legend: {
                display: false
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    const maxes = [30, 25, 20, 15, 10];
                    return `${context.raw} / ${maxes[context.dataIndex]} 点`;
                  }
                }
              }
            }
          }
        });
      }

      // Transition
      formSection.classList.add('hidden');
      resultSection.classList.remove('hidden');
      
      // Auto-scroll to results
      setTimeout(() => {
        resultSection.classList.remove('opacity-0');
        const alertBounds = deficitAlert.classList.contains('hidden') ? null : deficitAlert.getBoundingClientRect();
        const yOffset = alertBounds ? -20 : -20;
        const targetElement = deficitAlert.classList.contains('hidden') ? resultSection : deficitAlert;
        const y = targetElement.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }, 50);

    });

    // Check for auto-submit query param `?result=true`
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('result') === 'true' && localStorage.getItem(STORAGE_KEY)) {
      // Small timeout to allow everything to render before dispatching
      setTimeout(() => {
        form.dispatchEvent(new Event('submit'));
        // remove query param from url to avoid re-triggering on reload
        window.history.replaceState({}, document.title, window.location.pathname);
      }, 100);
    }
  });
</script>
